    {
      "cell_type": "code",
      "source": [
        "# Separate features and labels\n",
        "X = data.iloc[:, 0:4].values\n",
        "y = data.iloc[:, 4].values\n",
        "\n",
        "# Encode labels manually\n",
        "labels = {'Iris-setosa':0, 'Iris-versicolor':1, 'Iris-virginica':2}\n",
        "y = np.array([labels[i] for i in y])\n",
        "\n",
        "# One-hot encoding\n",
        "y_encoded = np.zeros((y.size, 3))\n",
        "for i in range(y.size):\n",
        "    y_encoded[i, y[i]] = 1\n",
        "\n",
        "# Normalize features\n",
        "X = X / X.max(axis=0)\n"
      ],
      "metadata": {
        "id": "zhY91b_t0Zdr"
      },
      "execution_count": 4,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "def sigmoid(x):\n",
        "    return 1 / (1 + np.exp(-x))\n",
        "\n",
        "def sigmoid_derivative(x):\n",
        "    return x * (1 - x)\n"
      ],
      "metadata": {
        "id": "W5Ivvc-K0bZ8"
      },
      "execution_count": 5,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# **Activation Functions**"
      ],
      "metadata": {
        "id": "c0mZJZn01UY1"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "np.random.seed(1)\n",
        "\n",
        "input_neurons = 4\n",
        "hidden_neurons = 5\n",
        "output_neurons = 3\n",
        "\n",
        "W1 = np.random.rand(input_neurons, hidden_neurons)\n",
        "W2 = np.random.rand(hidden_neurons, output_neurons)\n",
        "\n",
        "learning_rate = 0.5\n",
        "epochs = 10\n"
      ],
      "metadata": {
        "id": "AGrFGcQi0cek"
      },
      "execution_count": 6,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "# **Training the Neural Network (WITH WEIGHT DISPLAY)**"
      ],
      "metadata": {
        "id": "zD-mVwAe1XKl"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "for epoch in range(epochs):\n",
        "\n",
        "    # ---- Forward Propagation ----\n",
        "    hidden_input = np.dot(X, W1)\n",
        "    hidden_output = sigmoid(hidden_input)\n",
        "\n",
        "    final_input = np.dot(hidden_output, W2)\n",
        "    final_output = sigmoid(final_input)\n",
        "\n",
        "    # ---- Error Calculation ----\n",
        "    error = y_encoded - final_output\n",
        "    loss = np.mean(error ** 2)\n",
        "\n",
        "    # ---- Backward Propagation ----\n",
        "    d_output = error * sigmoid_derivative(final_output)\n",
        "    d_hidden = np.dot(d_output, W2.T) * sigmoid_derivative(hidden_output)\n",
        "\n",
        "    # ---- Weight Updates ----\n",
        "    W2 += learning_rate * np.dot(hidden_output.T, d_output)\n",
        "    W1 += learning_rate * np.dot(X.T, d_hidden)\n",
        "\n",
        "    # ---- Display Updated Weights ----\n",
        "    print(f\"\\nEpoch {epoch+1}\")\n",
        "    print(\"Loss:\", loss)\n",
        "    print(\"\\nUpdated Weights W1 (Input → Hidden):\\n\", W1)\n",
        "    print(\"\\nUpdated Weights W2 (Hidden → Output):\\n\", W2)\n"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Qw1qG38a0egb",
        "outputId": "2cf978eb-dc38-485c-de79-46891737e268"
